# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aiagent

# JWT — change this in production!
SECRET_KEY=change-this-to-a-very-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
MEMORY_WINDOW=20
